{
  "id": "ai-goap-access-key",
  "title": "Stage 9A GOAP: Spatial Access-Key Planning",
  "description": "Production GOAP decision plans directed semantic location transitions while collecting three physical coins, purchasing the key at its shop, and reaching the destination.",
  "roles": {
    "agent": "GOAP_Agent",
    "start": "GOAP_Start",
    "accessKey": "GOAP_Access_Key",
    "finalGoal": "GOAP_Final_Goal",
    "coinA": "GOAP_Coin_A",
    "coinB": "GOAP_Coin_B",
    "coinC": "GOAP_Coin_C"
  },
  "setup": [
    {
      "op": "ensureNodeBoundEntity",
      "entity": "agent"
    },
    {
      "op": "captureTransform",
      "entity": "agent",
      "slot": "baseline"
    },
    {
      "op": "ensureAI",
      "entity": "agent"
    },
    {
      "op": "ensureNodeBoundEntity",
      "entity": "coinA"
    },
    {
      "op": "ensurePickup",
      "entity": "coinA",
      "collectionRadius": 0.6
    },
    {
      "op": "ensureNodeBoundEntity",
      "entity": "coinB"
    },
    {
      "op": "ensurePickup",
      "entity": "coinB",
      "collectionRadius": 0.6
    },
    {
      "op": "ensureNodeBoundEntity",
      "entity": "coinC"
    },
    {
      "op": "ensurePickup",
      "entity": "coinC",
      "collectionRadius": 0.6
    },
    {
      "op": "ensureNodeBoundEntity",
      "entity": "accessKey"
    }
  ],
  "start": [
    {
      "op": "cancelAIDecision",
      "entity": "agent"
    },
    {
      "op": "cancelAI",
      "entity": "agent"
    },
    {
      "op": "restoreTransform",
      "entity": "agent",
      "slot": "baseline"
    },
    {
      "op": "resetEntitySimulationState",
      "entity": "agent"
    },
    {
      "op": "teleportPhysicsCharacter",
      "entity": "agent"
    },
    {
      "op": "resetPickup",
      "entity": "coinA"
    },
    {
      "op": "resetPickup",
      "entity": "coinB"
    },
    {
      "op": "resetPickup",
      "entity": "coinC"
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "coinA",
      "visible": true
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "coinB",
      "visible": true
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "coinC",
      "visible": true
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "accessKey",
      "visible": true
    },
    {
      "op": "startAIDecision",
      "entity": "agent",
      "decision": "access_key",
      "result": "GOAP decision"
    }
  ],
  "stop": [
    {
      "op": "cancelAIDecision",
      "entity": "agent"
    },
    {
      "op": "cancelAI",
      "entity": "agent"
    }
  ],
  "reset": [
    {
      "op": "cancelAIDecision",
      "entity": "agent"
    },
    {
      "op": "cancelAI",
      "entity": "agent"
    },
    {
      "op": "restoreTransform",
      "entity": "agent",
      "slot": "baseline"
    },
    {
      "op": "resetEntitySimulationState",
      "entity": "agent"
    },
    {
      "op": "teleportPhysicsCharacter",
      "entity": "agent"
    },
    {
      "op": "resetPickup",
      "entity": "coinA"
    },
    {
      "op": "resetPickup",
      "entity": "coinB"
    },
    {
      "op": "resetPickup",
      "entity": "coinC"
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "coinA",
      "visible": true
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "coinB",
      "visible": true
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "coinC",
      "visible": true
    },
    {
      "op": "setRuntimeVisibility",
      "entity": "accessKey",
      "visible": true
    }
  ]
}