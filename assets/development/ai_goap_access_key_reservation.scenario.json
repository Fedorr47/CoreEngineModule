{
  "id": "ai-goap-access-key-reservation",
  "title": "Stage 11 GOAP: Multi-Agent Resource Reservation",
  "description": "Two production Access Key agents resolve shared-coin contention through reservations and same-goal replanning.",
  "roles": {
    "agentA": "GOAP_Agent_A",
    "agentB": "GOAP_Agent_B",
    "start": "GOAP_Start",
    "accessKey": "GOAP_Access_Key",
    "finalGoal": "GOAP_Final_Goal",
    "coinA": "GOAP_Coin_A",
    "coinB": "GOAP_Coin_B",
    "coinC": "GOAP_Coin_C"
  },
  "setup": [
    { "op": "ensureNodeBoundEntity", "entity": "agentA" },
    { "op": "captureTransform", "entity": "agentA", "slot": "agentABaseline" },
    { "op": "ensureAI", "entity": "agentA" },
    { "op": "ensureNodeBoundEntity", "entity": "agentB" },
    { "op": "captureTransform", "entity": "agentB", "slot": "agentBBaseline" },
    { "op": "ensureAI", "entity": "agentB" },
    { "op": "ensureNodeBoundEntity", "entity": "coinA" },
    { "op": "ensurePickup", "entity": "coinA", "collectionRadius": 0.6 },
    { "op": "ensureInteractionPoint", "entity": "coinA" },
    { "op": "ensureNodeBoundEntity", "entity": "coinB" },
    { "op": "ensurePickup", "entity": "coinB", "collectionRadius": 0.6 },
    { "op": "ensureInteractionPoint", "entity": "coinB" },
    { "op": "ensureNodeBoundEntity", "entity": "coinC" },
    { "op": "ensurePickup", "entity": "coinC", "collectionRadius": 0.6 },
    { "op": "ensureInteractionPoint", "entity": "coinC" },
    { "op": "ensureNodeBoundEntity", "entity": "accessKey" }
  ],
  "start": [
    { "op": "cancelAIDecision", "entity": "agentA" },
    { "op": "cancelAI", "entity": "agentA" },
    { "op": "restoreTransform", "entity": "agentA", "slot": "agentABaseline" },
    { "op": "resetEntitySimulationState", "entity": "agentA" },
    { "op": "teleportPhysicsCharacter", "entity": "agentA" },
    { "op": "cancelAIDecision", "entity": "agentB" },
    { "op": "cancelAI", "entity": "agentB" },
    { "op": "restoreTransform", "entity": "agentB", "slot": "agentBBaseline" },
    { "op": "resetEntitySimulationState", "entity": "agentB" },
    { "op": "teleportPhysicsCharacter", "entity": "agentB" },
    { "op": "resetPickup", "entity": "coinA" },
    { "op": "resetPickup", "entity": "coinB" },
    { "op": "resetPickup", "entity": "coinC" },
    { "op": "setRuntimeVisibility", "entity": "coinA", "visible": true },
    { "op": "setRuntimeVisibility", "entity": "coinB", "visible": true },
    { "op": "setRuntimeVisibility", "entity": "coinC", "visible": true },
    { "op": "setRuntimeVisibility", "entity": "accessKey", "visible": true },
    { "op": "startAIDecision", "entity": "agentB", "decision": "access_key_reserved", "result": "GOAP decision B" },
    { "op": "startAIDecision", "entity": "agentA", "decision": "access_key_reserved", "result": "GOAP decision A" }
  ],
  "update": [],
  "stop": [
    { "op": "cancelAIDecision", "entity": "agentA" },
    { "op": "cancelAI", "entity": "agentA" },
    { "op": "cancelAIDecision", "entity": "agentB" },
    { "op": "cancelAI", "entity": "agentB" }
  ],
  "reset": [
    { "op": "cancelAIDecision", "entity": "agentA" },
    { "op": "cancelAI", "entity": "agentA" },
    { "op": "restoreTransform", "entity": "agentA", "slot": "agentABaseline" },
    { "op": "resetEntitySimulationState", "entity": "agentA" },
    { "op": "teleportPhysicsCharacter", "entity": "agentA" },
    { "op": "cancelAIDecision", "entity": "agentB" },
    { "op": "cancelAI", "entity": "agentB" },
    { "op": "restoreTransform", "entity": "agentB", "slot": "agentBBaseline" },
    { "op": "resetEntitySimulationState", "entity": "agentB" },
    { "op": "teleportPhysicsCharacter", "entity": "agentB" },
    { "op": "resetPickup", "entity": "coinA" },
    { "op": "resetPickup", "entity": "coinB" },
    { "op": "resetPickup", "entity": "coinC" },
    { "op": "setRuntimeVisibility", "entity": "coinA", "visible": true },
    { "op": "setRuntimeVisibility", "entity": "coinB", "visible": true },
    { "op": "setRuntimeVisibility", "entity": "coinC", "visible": true },
    { "op": "setRuntimeVisibility", "entity": "accessKey", "visible": true }
  ]
}