%% title: SelectAIGoal: фильтрация, оценка и выбор с победой первой цели при равенстве
%% kind: flowchart (алгоритм)
%% level: детали
%% refs: GS-SELECT, GS-SCORE, GS-TIE, AU-GOAL-BUILD
flowchart TB
  A(["для каждой цели в порядке определения"]) --> B{"goalId валиден,<br/>baseScore конечен?"}
  B -->|"нет"| A
  B -->|"да"| C{"desiredFacts уже<br/>выполнены?"}
  C -->|"да: цель достигнута"| A
  C -->|"нет"| D["score = baseScore +<br/>Σ scoreDelta выполненных правил"]
  D --> E{"правила валидны,<br/>score конечен?"}
  E -->|"нет"| A
  E -->|"да"| F{"нет выбранной или<br/>score > лучший?"}
  F -->|"да"| G["выбрать эту цель"]
  F -->|"нет (в т.ч. равенство)"| A
  G --> A
  A -->|"цели закончились"| H(["результат или «нет цели»"])
